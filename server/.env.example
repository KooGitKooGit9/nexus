# Copy to server/.env and fill in.
# Google AI Studio → Get API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_API_KEY=mock  → offline scripted Gemini (no network) for testing the agent loop
# Optional. Default: gemini-3.8-flash  (cheaper: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash
NEXUS_API_PORT=5200
