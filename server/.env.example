# Copy to server/.env (local) or set as environment variables on your host. Real env vars win over this file.
# Never commit server/.env.

# ── AI (Google Gemini) ── https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_API_KEY=mock  → offline scripted Gemini (no network) for testing the agent loop
# Optional. Default: gemini-3.8-flash  (cheaper: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.8-flash

# ── Public URL ── used for invite / password-reset links. https://… also turns on Secure cookies + HSTS.
# NEXUS_PUBLIC_URL=https://nexus.example.com

# ── Email (Resend) ── without these, reset/invite links are printed to the server console instead.
# RESEND_API_KEY=re_xxx
# MAIL_FROM="Nexus <no-reply@nexus.example.com>"

# ── Payments (Toss Payments) ── without both keys, billing offers only the 14-day free trial.
# TOSS_CLIENT_KEY=test_ck_xxx
# TOSS_SECRET_KEY=test_sk_xxx

# ── Server ──
# Dev API port (Vite proxies /api and /ws here). Production uses PORT instead.
NEXUS_API_PORT=5200
# PORT=8080
# Where the SQLite DB + uploads live (default: server/data)
# NEXUS_DATA_DIR=/var/lib/nexus
# Set to 1 behind a reverse proxy (Fly, Railway, Caddy, nginx) so rate limits use the real client IP.
# NEXUS_TRUST_PROXY=1
